{
  "name": "@doc-studio/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "doc-studio-mcp": "./dist/stdio.js",
    "doc-studio-mcp-http": "./dist/http.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./http-handler": {
      "types": "./src/http-handler.ts",
      "default": "./dist/http-handler.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @doc-studio/core build",
    "build": "tsc",
    "pretest": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts"
  },
  "dependencies": {
    "@doc-studio/core": "workspace:*",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
