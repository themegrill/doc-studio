{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm --filter @doc-studio/mcp-server build",
    "build": "node db/migrate-on-build.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "cd ../.. && docker-compose up -d",
    "db:stop": "cd ../.. && docker-compose down",
    "db:reset": "cd ../.. && docker-compose down -v && docker-compose up -d",
    "db:logs": "cd ../.. && docker-compose logs -f postgres",
    "db:migrate": "tsx scripts/utils/run-migration.ts",
    "sync-kb": "tsx scripts/utils/sync-knowledge-bases.ts",
    "sync-kb:clear": "tsx scripts/utils/sync-knowledge-bases.ts --clear",
    "create-missed-tables": "tsx scripts/utils/create-ai-usage-table.ts && tsx scripts/utils/create-global-settings-table.ts",
    "sync-client": "node scripts/sync-client.js",
    "sync-client:dry": "node scripts/sync-client.js --dry-run",
    "check:editorial": "tsx scripts/check-editorial-rules.ts"
  },
  "dependencies": {
    "@doc-studio/core": "workspace:*",
    "@doc-studio/mcp-server": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.35",
    "@anthropic-ai/sdk": "^0.80.0",
    "@blocknote/core": "^0.46.2",
    "@blocknote/mantine": "^0.46.2",
    "@blocknote/react": "^0.46.2",
    "@blocknote/xl-ai": "^0.46.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^8.3.13",
    "@mantine/hooks": "^8.3.13",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vercel/blob": "^2.3.2",
    "ai": "^6.0.68",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "domhandler": "^6.0.1",
    "lucide-react": "^0.563.0",
    "mime-types": "^3.0.2",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "p-limit": "^7.3.0",
    "postgres": "^3.4.8",
    "prosemirror-state": "^1.4.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shiki": "^4.3.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "adm-zip": "^0.5.17",
    "dotenv": "^17.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
